# Copy to .env and fill in locally. Never commit .env.
# Variable names only: no real values belong in this file.

# Model provider key. Used only by the host orchestrator, never passed to a sandbox.
ANTHROPIC_API_KEY=

# Optional. Public repositories need no token; this only raises rate limits.
# Use a fine-grained token with read-only access to public repositories.
# It is sent to api.github.com only, never to git or a sandbox.
PATCHPILOT_GITHUB_TOKEN=

# TOML file of approved repositories. Without it nothing is approved.
PATCHPILOT_ALLOWLIST_PATH=
