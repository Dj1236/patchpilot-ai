# Copy to .env and fill in locally. Never commit .env.
# Variable names only: no real values belong in this file.

# PatchPilot does not load this file. Export the variables in the shell that
# starts it.

# Model provider: anthropic (default) or gemini.
PATCHPILOT_PROVIDER=

# Gemini only: gemini-3.8-flash (default) or gemini-3.6-flash. One model per
# process; nothing switches model after a failure.
PATCHPILOT_GEMINI_MODEL=

# Model provider keys. Used only by the host orchestrator, never passed to a
# sandbox. Set only the one for the chosen provider.
ANTHROPIC_API_KEY=
# Must belong to a Google project with no billing account. Do not set
# GOOGLE_API_KEY: PatchPilot refuses to run with it.
GEMINI_API_KEY=

# Set to 1 only after checking, in Google AI Studio, that the Gemini key's
# project is on the free tier with no billing account. Needed for live runs.
PATCHPILOT_GEMINI_FREE_TIER_CONFIRMED=

# Optional. Public repositories need no token; this only raises rate limits.
# Use a fine-grained token with read-only access to public repositories.
# It is sent to api.github.com only, never to git or a sandbox.
PATCHPILOT_GITHUB_TOKEN=

# TOML file of approved repositories. Without it nothing is approved.
PATCHPILOT_ALLOWLIST_PATH=
