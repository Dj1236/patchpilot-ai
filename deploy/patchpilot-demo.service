# systemd unit for the PatchPilot demo (see deploy/README.md).
[Unit]
Description=PatchPilot AI demo (FastAPI)
After=network-online.target docker.service ollama.service
Requires=docker.service

[Service]
User=patchpilot
WorkingDirectory=/opt/patchpilot-ai
Environment=PATCHPILOT_DEMO_RUNS_DIR=/var/lib/patchpilot/runs HOME=/var/lib/patchpilot
EnvironmentFile=-/etc/patchpilot/demo.env
# Listens on localhost only; Caddy terminates TLS and proxies to it.
ExecStart=/opt/patchpilot-ai/.venv/bin/uvicorn patchpilot.demo.app:create_app --factory --host 127.0.0.1 --port 8090 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/patchpilot
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
